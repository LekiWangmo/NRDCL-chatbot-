OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.2:latest
EMBED_MODEL=nomic-embed-text
MIN_SIMILARITY=0.35
# Optional for an authenticated, remotely hosted Ollama gateway:
OLLAMA_API_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
MODEL_TIMEOUT=120
CHAT_REQUESTS_PER_MINUTE=10
# Render uses knowledge/index.json; local runs prefer data/index.json.
# INDEX_PATH=knowledge/index.json
